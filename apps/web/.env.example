# ==========================================================================
# OttoUGC — configuration
#
# Nothing here is required to start. Anything left empty puts that module into
# stand-in mode, and the app says so in Settings. Full steps in docs/SETUP.md.
# ==========================================================================

# -- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=change-me-in-production

# -- Database ---------------------------------------------------------------
# Empty: local PGlite in .pglite (Postgres compiled to WASM, same dialect).
# Supabase: transaction pooler (6543) for the app, direct (5432) for migrations.
# DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# DIRECT_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# -- Google Cloud (Gemini, Veo, Imagen, Lyria, TTS, STT) --------------------
# The full service account JSON on one line, or base64-encoded.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# GOOGLE_CLOUD_PROJECT=ottougc-prod
GOOGLE_CLOUD_LOCATION=us-central1
# Gemini 3.7 Flash + Omni interactions: global Vertex endpoint.
# GOOGLE_CLOUD_GEMINI_LOCATION=global
# GCS_BUCKET=ottougc-prod-ottougc-assets

# Lighter option: an AI Studio key. This is what unlocks Gemini Omni Flash for
# video and the agents' model. Imagen, Lyria and Chirp still need the service
# account above.
# GEMINI_API_KEY=

# -- Models -----------------------------------------------------------------
MODEL_BRAIN=gemini-3.7-flash
MODEL_STRATEGIST=gemini-3.1-pro
MODEL_FAST=gemini-3.1-flash-lite
MODEL_VIDEO=gemini-omni-flash-preview
MODEL_VIDEO_FAST=gemini-omni-flash-preview
MODEL_IMAGE=gemini-2.5-flash-image
MODEL_IMAGE_HIFI=imagen-4.0-generate-001
MODEL_MUSIC=lyria-002
MODEL_TTS_VOICE=en-US-Chirp3-HD-Aoede

# -- YouTube ----------------------------------------------------------------
# A "Web application" OAuth client.
# Redirect URI to register: {NEXT_PUBLIC_APP_URL}/api/auth/youtube/callback
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# Set true once Google has verified the consent screen.
YOUTUBE_OAUTH_VERIFIED=false

# -- Limits -----------------------------------------------------------------
# true = nothing is sent to YouTube; the pipeline still runs end to end.
DRY_RUN_PUBLISHING=true
# true = force stand-in media even with valid credentials.
FORCE_MOCK_MEDIA=false
DAILY_GENERATION_BUDGET_USD=10
MAX_AGENT_STEPS=40
MAX_PARALLEL_RENDERS=2

# -- Pricing ----------------------------------------------------------------
PRICE_PER_VIDEO_USD=5
PRICE_PER_CPM_USD=1

# -- Scheduled jobs ---------------------------------------------------------
# Required in production: without it, anyone can trigger a run and burn your
# generation budget.
# CRON_SECRET=
