{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 pnpm install",
  "buildCommand": "pnpm build",
  "crons": [
    { "path": "/api/cron/produce", "schedule": "0 7 * * *" },
    { "path": "/api/cron/publish", "schedule": "0 8 * * *" }
  ]
}
