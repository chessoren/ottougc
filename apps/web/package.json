{
  "name": "@ottougc/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --tsconfig tsconfig.cli.json src/server/db/seed.ts",
    "agent:run": "tsx src/server/agents/cli.ts",
    "db:migrate": "tsx --tsconfig tsconfig.cli.json src/server/db/migrate.ts",
    "agent": "tsx --tsconfig tsconfig.cli.json src/server/agents/cli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@google-cloud/speech": "^6.7.0",
    "@google-cloud/storage": "^7.14.0",
    "@google-cloud/text-to-speech": "^5.6.0",
    "@google/genai": "^1.30.0",
    "@remotion/bundler": "4.0.518",
    "@remotion/renderer": "4.0.518",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.38.4",
    "google-auth-library": "^9.15.1",
    "googleapis": "^144.0.0",
    "lucide-react": "^0.469.0",
    "nanoid": "^5.0.9",
    "next": "^15.1.6",
    "playwright": "^1.62.1",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "remotion": "4.0.518",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.30.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
